# Server-only Resend API key. Never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=

# Sender address from a domain you own and have verified in Resend.
# Do not use the visitor's address or your Gmail inbox as the sender.
# For local testing only, onboarding@resend.dev can send to the Resend account owner's exact email.
CONTACT_FROM_EMAIL=
